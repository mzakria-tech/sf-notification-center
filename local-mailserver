def _status_pill(status: str) -> str:
    s = status.lower()
    if "in progress" in s:
        cls = "inprogress"
    elif "waiting on red hat" in s:
        cls = "waiting-rh"
    elif "waiting on customer" in s or "customer responded" in s:
        cls = "waiting-cust"
    elif "closed" in s:
        cls = "closed"
    elif "new" in s:
        cls = "new"
    else:
        cls = "default"
    return f'<span class="status-pill {cls}">{status}</span>'


def _render(data: dict) -> str:
    def svc(d):
        return ("on", "Running") if d["running"] else ("off", "Stopped")

    ms_cls, ms_text = svc(data["mailserver"])
    pl_cls, pl_text = svc(data["poller"])
    cr_cls, cr_text = svc(data["chrome"])
    ma_cls, ma_text = svc(data["mailapp"])

    # Start buttons for stopped services
    def start_btn(svc_id, label="▶ Start"):
        return f'<button class="start-btn" onclick="startService(\'{svc_id}\', this)">{label}</button>'

    ms_fix = "" if data["mailserver"]["running"] else start_btn("mailserver", "▶ Start Mail Server")
    pl_fix = "" if data["poller"]["running"] else start_btn("poller", "▶ Start Poller")
    cr_fix = "" if data["chrome"]["running"] else start_btn("chrome", "▶ Open Chrome")
    ma_fix = "" if data["mailapp"]["running"] else start_btn("mailapp", "▶ Open Mail.app")

    # Cases table — dynamically match Salesforce columns
    cases = data["cases"]
    columns = data.get("columns", [])
    # Filter out empty/action columns
    skip_labels = {"", "action", "show actions"}
    display_cols = [c for c in columns if c.lower() not in skip_labels]

    if cases:
        # Build header
        header_cells = ""
        for col in display_cols:
            header_cells += f"<th>{col}</th>"
        if not display_cols:
            header_cells = "<th>Case #</th><th>Status</th><th>Subject</th>"

        # Build rows
        rows = ""
        for c in cases:
            link = f'https://redhatsupport.lightning.force.com/lightning/r/Case/{c["id"]}/view'
            fields = c.get("fields", {})
            if display_cols:
                cells = ""
                for col in display_cols:
                    val = fields.get(col, "")
                    col_lower = col.lower()
                    if "case number" in col_lower:
                        cells += f'<td><a class="case-link" href="{link}" target="_blank"><span class="case-num">{val}</span></a></td>'
                    elif col_lower == "status":
                        cells += f"<td>{_status_pill(val)}</td>"
                    elif "subject" in col_lower:
                        cells += f'<td style="color:#e2e8f0">{val[:70]}</td>'
                    elif "owner" in col_lower:
                        cells += f'<td style="color:#60a5fa;font-weight:600">{val}</td>'
                    elif "severity" in col_lower:
                        cells += f'<td style="font-size:12px;color:#94a3b8">{val}</td>'
                    else:
                        cells += f'<td style="font-size:12px;color:#cbd5e1">{val[:50]}</td>'
                rows += f"<tr>{cells}</tr>"
            else:
                rows += (
                    f'<tr>'
                    f'<td><a class="case-link" href="{link}" target="_blank"><span class="case-num">{c["number"]}</span></a></td>'
                    f'<td>{_status_pill(c["status"])}</td>'
                    f'<td style="color:#e2e8f0">{c["subject"][:60]}</td>'
                    f'</tr>'
                )
        cases_html = (
            '<table class="case-table"><thead><tr>'
            + header_cells +
            '</tr></thead><tbody>' + rows + '</tbody></table>'
        )
    else:
        cases_html = '<div class="empty"><div class="empty-icon">📭</div>No cases tracked yet — waiting for first successful poll</div>'

    # Emails
    emails = data["emails"]
    if emails:
        cards = ""
        for e in emails:
            body = (e.get("body") or "")[:200].replace("<", "&lt;")
            cards += (
                f'<div class="email-card">'
                f'<div class="email-top"><span class="email-subj">{e["subject"]}</span>'
                f'<span class="email-date">{e["date"]}</span></div>'
                f'<div class="email-from">To: {e.get("to","")}</div>'
                f'<div class="email-body">{body}</div></div>'
            )
        emails_html = cards
    else:
        emails_html = '<div class="empty"><div class="empty-icon">🔕</div>No notifications yet — emails appear here when a case status changes</div>'

    # Log
    log_lines = data["logs"]
    log_html = ""
    for line in log_lines:
        cls = "ok" if "ok cases=" in line else ("err" if "failed" in line or "error" in line.lower() else "info")
        ts = line[:20] if len(line) > 20 else ""
        msg = line[21:] if len(line) > 21 else line
        log_html += f'<div class="log-line"><span class="ts">{ts}</span> <span class="{cls}">{msg}</span></div>'
    if not log_html:
        log_html = '<div class="log-line">No log entries yet</div>'

    # Last run
    lr = data.get("last_run", "")
    if lr:
        try:
            dt = datetime.fromisoformat(lr)
            ago = (datetime.now(timezone.utc) - dt).total_seconds()
            if ago < 60:
                lr_text = f"{int(ago)}s ago"
            elif ago < 3600:
                lr_text = f"{int(ago/60)}m ago"
            else:
                lr_text = f"{int(ago/3600)}h ago"
        except Exception:
            lr_text = lr[:19]
    else:
        lr_text = "never"

    scrape = data.get("last_scrape", "unknown")
    scrape_map = {"success": "✅ last scrape OK", "failed": "❌ last scrape failed", "unknown": "⏳ pending"}
    scrape_text = scrape_map.get(scrape, scrape)

    html = DASHBOARD
    replacements = {
        "{ms_cls}": ms_cls, "{ms_text}": ms_text, "{ms_fix}": ms_fix,
        "{pl_cls}": pl_cls, "{pl_text}": pl_text, "{pl_fix}": pl_fix,
        "{cr_cls}": cr_cls, "{cr_text}": cr_text, "{cr_fix}": cr_fix,
        "{ma_cls}": ma_cls, "{ma_text}": ma_text, "{ma_fix}": ma_fix,
        "{case_count}": str(data["case_count"]),
        "{email_count}": str(data["email_count"]),
        "{last_run}": lr_text,
        "{scrape_status}": scrape_text,
        "{cases_html}": cases_html,
        "{emails_html}": emails_html,
        "{log_html}": log_html,
        "{case_list_url}": data.get("case_list_url", ""),
        "{notify_email}": data.get("notify_email", "not configured"),
    }
    for k, v in replacements.items():
        html = html.replace(k, v)
    return html


class WebHandler(BaseHTTPRequestHandler):
    def do_POST(self):
        """Handle service start requests from dashboard."""
        if self.path == "/api/start":
            length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(length).decode() if length else ""
            try:
                req = json.loads(body)
            except Exception:
                req = {}
            svc = req.get("service", "")
            result = {"ok": False, "msg": "unknown service"}
            if svc == "poller":
                r = subprocess.run(["launchctl", "load", os.path.expanduser("~/Library/LaunchAgents/com.sf-notify.case-poller.plist")], capture_output=True, text=True)
                result = {"ok": r.returncode == 0, "msg": (r.stderr or r.stdout or "started").strip()}
            elif svc == "chrome":
                r = subprocess.run(["open", "-a", "Google Chrome"], capture_output=True, text=True)
                result = {"ok": r.returncode == 0, "msg": "opened"}
            elif svc == "mailapp":
                r = subprocess.run(["open", "-a", "Mail"], capture_output=True, text=True)
                result = {"ok": r.returncode == 0, "msg": "opened"}
            elif svc == "mailserver":
                result = {"ok": True, "msg": "already running"}
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(result).encode())
            return

        if self.path == "/api/config":
            length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(length).decode() if length else ""
            try:
                req = json.loads(body)
            except Exception:
                req = {}
            new_url = req.get("case_list_url", "").strip()
            if new_url and "lightning" in new_url:
                cfg = _read_config()
                cfg["case_list_url"] = new_url
                _save_config(cfg)
                # Restart poller with new URL
                plist = os.path.expanduser("~/Library/LaunchAgents/com.sf-notify.case-poller.plist")
                subprocess.run(["launchctl", "unload", plist], capture_output=True)
                import time; time.sleep(1)
                # Clear state so it re-initialises with new view
                state_f = os.path.expanduser("~/.local/state/sf-case-status.json")
                if os.path.exists(state_f):
                    os.remove(state_f)
                subprocess.run(["launchctl", "load", plist], capture_output=True)
                result = {"ok": True, "msg": "Saved & poller restarted"}
            else:
                result = {"ok": False, "msg": "Invalid URL"}
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(result).encode())
            return

        self.send_response(404)
        self.end_headers()

    def do_GET(self):
        if self.path == "/api/status":
            data = _get_status_data()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(data, default=str).encode())
            return

        if self.path == "/api/emails":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(EMAILS).encode())
            return

        data = _get_status_data()
        html = _render(data)
        self.send_response(200)
        self.send_header("Content-Type", "text/html")
        self.end_headers()
        self.wfile.write(html.encode())

    def log_message(self, fmt, *args):
        pass


def run_web(port=8090):
    server = HTTPServer(("0.0.0.0", port), WebHandler)
    print(f"[WEB]  http://localhost:{port}")
    server.serve_forever()


