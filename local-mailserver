"""SF Notification Center — Web dashboard + local SMTP.

SMTP on port 2525, Web UI on port 8090.
Shows live service health, tracked cases, and email notifications.
"""

import asyncio
import json
import os
import subprocess
import threading
from http.server import HTTPServer, BaseHTTPRequestHandler
from datetime import datetime, timezone
from aiosmtpd.controller import Controller
from aiosmtpd.handlers import Message

EMAILS = []
STATE_PATH = os.path.expanduser("~/.local/state/sf-case-status.json")
CONFIG_PATH = os.path.expanduser("~/.local/state/sf-poller-config.json")
POLLER_LOG = os.path.expanduser("~/Library/Logs/sf-case-poller.log")


def _read_config() -> dict:
    try:
        with open(CONFIG_PATH) as f:
            return json.load(f)
    except Exception:
        return {}


def _save_config(cfg: dict) -> None:
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    with open(CONFIG_PATH, "w") as f:
        json.dump(cfg, f, indent=2)


class MailHandler(Message):
    def handle_message(self, message):
        entry = {
            "id": len(EMAILS) + 1,
            "from": message.get("From", ""),
            "to": message.get("To", ""),
            "subject": message.get("Subject", "(no subject)"),
            "date": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "body": message.get_payload(decode=True).decode("utf-8", errors="replace")
                    if not message.is_multipart()
                    else str(message.get_payload()),
        }
        EMAILS.insert(0, entry)
        if len(EMAILS) > 100:
            EMAILS[:] = EMAILS[:100]
        print(f"[MAIL] {entry['date']}  Subject: {entry['subject']}")


def _check_service(name: str) -> dict:
    """Check if a service is running."""
    if name == "poller":
        r = subprocess.run(["launchctl", "list"], capture_output=True, text=True)
        running = "com.sf-notify.case-poller" in (r.stdout or "")
        return {"running": running, "label": "SF Case Poller"}
    elif name == "mailserver":
        return {"running": True, "label": "Mail Server"}
    elif name == "chrome":
        r = subprocess.run(["pgrep", "-x", "Google Chrome"], capture_output=True)
        return {"running": r.returncode == 0, "label": "Google Chrome"}
    elif name == "mailapp":
        r = subprocess.run(["pgrep", "-x", "Mail"], capture_output=True)
        return {"running": r.returncode == 0, "label": "Mail.app"}
    return {"running": False, "label": name}


def _read_cases() -> tuple[list[dict], list[str]]:
    """Read current tracked cases and columns from state file."""
    try:
        with open(STATE_PATH) as f:
            state = json.load(f)
        columns = state.get("columns", [])
        cases = []
        for cid, info in (state.get("cases") or {}).items():
            cases.append({
                "id": cid,
                "number": info.get("number", ""),
                "status": info.get("status", ""),
                "subject": info.get("subject", ""),
                "fields": info.get("fields", {}),
            })
        return cases, columns
    except Exception:
        return [], []


def _read_state() -> dict:
    try:
        with open(STATE_PATH) as f:
            return json.load(f)
    except Exception:
        return {}


def _last_log_lines(n=5) -> list[str]:
    try:
        with open(POLLER_LOG) as f:
            lines = f.readlines()
        return [l.strip() for l in lines[-n:]]
    except Exception:
        return []


def _get_status_data() -> dict:
    """Gather all live status data."""
    poller = _check_service("poller")
    chrome = _check_service("chrome")
    mailapp = _check_service("mailapp")
    state = _read_state()
    cases, columns = _read_cases()
    logs = _last_log_lines(8)
    last_run = state.get("lastRun", "")
    initialized = state.get("initialized", False)

    # Parse last log for scrape status
    last_scrape = "unknown"
    for line in reversed(logs):
        if "cases=" in line:
            last_scrape = "success"
            break
        elif "scrape failed" in line:
            last_scrape = "failed"
            break

    cfg = _read_config()
    view_url = cfg.get("case_list_url", "")

    return {
        "poller": poller,
        "chrome": chrome,
        "mailapp": mailapp,
        "mailserver": {"running": True, "label": "Mail Server"},
        "cases": cases,
        "columns": columns,
        "case_count": len(cases),
        "email_count": len(EMAILS),
        "last_run": last_run,
        "initialized": initialized,
        "last_scrape": last_scrape,
        "logs": logs,
        "emails": EMAILS[:20],
        "case_list_url": view_url,
        "notify_email": cfg.get("notify_email", os.environ.get("SF_NOTIFY_EMAIL", "not configured")),
    }


