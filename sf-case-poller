def _strip_html(text: str) -> str:
    """Remove HTML tags and decode entities from comment body."""
    import re, html
    text = re.sub(r'<br\s*/?>', '\n', text, flags=re.IGNORECASE)
    text = re.sub(r'</p>', '\n', text, flags=re.IGNORECASE)
    text = re.sub(r'<[^>]+>', '', text)
    text = html.unescape(text)
    # Collapse multiple blank lines
    text = re.sub(r'\n{3,}', '\n\n', text)
    return text.strip()


def _format_comments(comments: list[dict]) -> str:
    if not comments:
        return ""
    lines = ["\n--- Recent Comments ---"]
    for c in comments:
        author = c.get("author", "").strip() or "Unknown"
        date = (c.get("date") or "")[:19].replace("T", " ")
        visibility = "Public" if c.get("isPublic", True) else "Private"
        body = _strip_html((c.get("body") or "").strip())
        if body:
            lines.append(f"\n[{visibility}] {author} ({date}):")
            lines.append(body[:400])
    return "\n".join(lines)


# ─── Hydra-only Comment Check (no Chrome, runs every 1 min) ───────────────
def _comment_only_check(conn: sqlite3.Connection):
    """Quick Hydra-only check for new comments — zero Chrome interaction."""
    if ssh_circuit.is_open:
        return
    rows = conn.execute(
        "SELECT case_id, case_number, external_number, owner_alias, last_comment_date, comment_count, subject, status "
        "FROM cases WHERE case_number != ''"
    ).fetchall()
    owned = []
    for r in rows:
        if r["owner_alias"] and SSH_USER and r["owner_alias"].lower() != SSH_USER.lower():
            continue
        cn = r["case_number"]
        owned.append((r["case_id"], cn, cn))
    if not owned:
        return
    api_nums = [a for _, _, a in owned]
    log_info("comment_check_start", mode="graphql", cases=len(api_nums))
    info = fetch_batch_comment_info(api_nums)
    if not info:
        return

    now = datetime.now(timezone.utc).isoformat()
    events = 0
    for cid, num, ext in owned:
        if ext not in info:
            continue
        ci = info[ext]
        new_date = ci.get("latestDate", "")
        new_count = ci.get("count", 0)

        row = conn.execute(
            "SELECT last_comment_date, comment_count FROM cases WHERE case_id=?", (cid,)
        ).fetchone()
        old_date = row["last_comment_date"] if row else ""
        old_count = row["comment_count"] if row else 0

        conn.execute(
            "UPDATE cases SET last_comment_date=?, comment_count=? WHERE case_id=?",
            (new_date, new_count, cid),
        )

        if old_date and new_date and new_date > old_date:
            new_comments_count = new_count - old_count if new_count > old_count else 1
            author = ci.get("latestAuthor", "Someone")
            ehash = _event_hash(cid, "COMMENT", old_date, new_date)
            existing = conn.execute("SELECT event_id FROM events WHERE event_hash=?", (ehash,)).fetchone()
            if existing:
                continue

            log_info("new_comment_detected", case=num, ext=ext, by=author, new_comments=new_comments_count)
            fetched = fetch_comments_hydra(ext)
            comment_text = _format_comments(fetched)

            case_row = conn.execute("SELECT subject, status FROM cases WHERE case_id=?", (cid,)).fetchone()
            subject = case_row["subject"] if case_row else ""
            cur_status = case_row["status"] if case_row else ""
            link = f"https://redhatsupport.lightning.force.com/lightning/r/Case/{cid}/view"

            conn.execute(
                "INSERT INTO events (case_id, case_number, event_type, old_value, new_value, event_time, event_hash, details) "
                "VALUES (?,?,?,?,?,?,?,?)",
                (cid, num, "COMMENT", old_date, new_date, now, ehash,
                 f"{new_comments_count} new comment(s) by {author}"),
            )
            event_id = conn.execute("SELECT last_insert_rowid()").fetchone()[0]

            title = f"New comment on Case {num}" + (f" ({new_comments_count} new)" if new_comments_count > 1 else "")
            body = (
                f"{'New comment' if new_comments_count == 1 else f'{new_comments_count} new comments'} on case {num}.\n"
                f"By: {author}\nStatus: {cur_status}\n"
                f"Subject: {subject}\n{link}\n{comment_text}\n"
            )
            queue_notification(conn, event_id, title, body)
            events += 1

    conn.commit()

    # Dispatch pending notifications
    if events > 0:
        pending = conn.execute(
            "SELECT notif_id FROM notifications WHERE status IN ('PENDING', 'RETRY')"
        ).fetchall()
        for row in pending:
            dispatch_notification(conn, row["notif_id"])

    log_info("comment_check_complete", mode="hydra_only", events=events)


# ─── Core Poll Logic ───────────────────────────────────────────────────────
def poll_once(conn: sqlite3.Connection) -> dict:
    """Single poll cycle. Returns stats dict."""
    run_start = datetime.now(timezone.utc).isoformat()
    stats = {"cases": 0, "events": 0, "notifications": 0, "status": "OK", "error": ""}

    # 1. Scrape cases from Chrome — zero disruption
    log_info("POLL_START")
    log_info("case_discovery_started", source="Chrome_background_JS")
    chrome_access = "NO"
    chrome_activation = "NO"
    tab_changed = "NO"
    page_reload = "NO"
    focus_changed = "NO"

    try:
        cases, columns = scrape_cases()
        chrome_access = "YES"
    except Exception as exc:
        stats["status"] = "SCRAPE_FAILED"
        stats["error"] = str(exc)[:200]
        log_error("scrape_failed", error=stats["error"])
        log_info("chrome_safety", access=chrome_access, activation=chrome_activation,
                 tab_changed=tab_changed, page_reload=page_reload, focus_changed=focus_changed)
        _write_heartbeat(0, "SCRAPE_FAILED", stats["error"])
        conn.execute(
            "INSERT INTO poll_runs (started_at, finished_at, status, error) VALUES (?,?,?,?)",
            (run_start, datetime.now(timezone.utc).isoformat(), "SCRAPE_FAILED", stats["error"]),
        )
        conn.commit()
        return stats

    log_info("chrome_safety", access=chrome_access, activation=chrome_activation,
             tab_changed=tab_changed, page_reload=page_reload, focus_changed=focus_changed)

    stats["cases"] = len(cases)
    initialized = _db_get(conn, "initialized") == "1"

    # 2. Suspicious result protection — if too few cases, use cached state
    prev_count = conn.execute("SELECT COUNT(*) as c FROM cases").fetchone()["c"]
    if len(cases) == 0 and prev_count > 5:
        log_warn("suspicious_empty_response", scraped=0, cached=prev_count,
                 action="skipping_cycle_using_cached_state")
        stats["status"] = "INSUFFICIENT_ROWS"
        _write_heartbeat(prev_count, "INSUFFICIENT_ROWS")
        conn.execute(
            "INSERT INTO poll_runs (started_at, finished_at, status, cases_found, error) VALUES (?,?,?,?,?)",
            (run_start, datetime.now(timezone.utc).isoformat(), "INSUFFICIENT_ROWS", 0,
             f"0 rows scraped, {prev_count} cached — SF virtual scroll may be hiding rows, will retry next cycle"),
        )
        conn.commit()
        return stats

    now = datetime.now(timezone.utc).isoformat()
    status_changed_cases = set()

    # 3. Detect status changes
    for rec in cases:
        cid = rec.get("Id") or rec.get("CaseNumber") or ""
        if not cid:
            continue
        num = rec.get("CaseNumber", "")
        ext_num = rec.get("ExternalNumber", "") or num
        status = rec.get("Status", "")
        subject = rec.get("Subject", "")
        owner = rec.get("OwnerAlias", "")
        last_mod = rec.get("LastModified", "")
        fields = rec.get("fields", {})

        old = conn.execute("SELECT * FROM cases WHERE case_id=?", (cid,)).fetchone()
        old_status = old["status"] if old else None
        old_last_mod = old["last_modified"] if old else ""

        # Upsert case (store external number for Hydra API compatibility)
        conn.execute("""
            INSERT INTO cases (case_id, case_number, external_number, status, subject, owner_alias, last_modified, fields_json, first_seen, last_seen)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ON CONFLICT(case_id) DO UPDATE SET
                case_number=excluded.case_number, external_number=excluded.external_number,
                status=excluded.status, subject=excluded.subject, owner_alias=excluded.owner_alias,
                last_modified=excluded.last_modified, fields_json=excluded.fields_json, last_seen=excluded.last_seen
        """, (cid, num, ext_num, status, subject, owner, last_mod, json.dumps(fields), now, now))

        if not initialized:
            continue

        # Owner filter
        if owner and SSH_USER and owner.lower() != SSH_USER.lower():
            continue

        # Status change detection
        if old_status is not None and old_status.strip().lower() != status.strip().lower():
            ehash = _event_hash(cid, "STATUS", old_status, status)
            existing = conn.execute("SELECT event_id FROM events WHERE event_hash=?", (ehash,)).fetchone()
            if existing:
                log_info("event_deduplicated", case=num, type="STATUS", hash=ehash)
                continue

            status_changed_cases.add(num)
            log_info("status_change_detected", case=num, old=old_status, new=status)

            # Fetch comments using external case number for Hydra
            comments = []
            if ext_num:
                comments = fetch_comments_hydra(ext_num)
                log_info("comments_fetched", case=num, ext=ext_num, count=len(comments))
            comment_text = _format_comments(comments)

            # Create event
            conn.execute(
                "INSERT INTO events (case_id, case_number, event_type, old_value, new_value, event_time, event_hash, details) "
                "VALUES (?,?,?,?,?,?,?,?)",
                (cid, num, "STATUS", old_status, status, now, ehash, comment_text[:2000]),
            )
            event_id = conn.execute("SELECT last_insert_rowid()").fetchone()[0]

            link = f"https://redhatsupport.lightning.force.com/lightning/r/Case/{cid}/view"
            title = f"Case {num}: {old_status} -> {status}"
            body = (
                f"Salesforce case {num} status changed.\n"
                f"From: {old_status}\nTo: {status}\n"
                f"Subject: {subject}\n{link}\n{comment_text}\n"
            )
            queue_notification(conn, event_id, title, body)
            stats["events"] += 1

    conn.commit()

    # 4. Batch comment check (one SSH call for all owned cases)
    #    Uses Red Hat GraphQL API for ALL cases
    if initialized and not ssh_circuit.is_open:
        owned = []
        for rec in cases:
            cid = rec.get("Id") or rec.get("CaseNumber") or ""
            owner = rec.get("OwnerAlias", "")
            if owner and SSH_USER and owner.lower() != SSH_USER.lower():
                continue
            num = rec.get("CaseNumber", "")
            if num and num not in status_changed_cases:
                owned.append((cid, num, num))

        if owned:
            log_info("batch_comment_check", count=len(owned))
            ext_nums = [e for _, _, e in owned]
            info = fetch_batch_comment_info(ext_nums)

            for cid, num, ext in owned:
                if ext not in info:
                    continue
                ci = info[ext]
                new_date = ci.get("latestDate", "")
                new_count = ci.get("count", 0)

                old = conn.execute(
                    "SELECT last_comment_date, comment_count FROM cases WHERE case_id=?", (cid,)
                ).fetchone()
                old_date = old["last_comment_date"] if old else ""
                old_count = old["comment_count"] if old else 0

                conn.execute(
                    "UPDATE cases SET last_comment_date=?, comment_count=? WHERE case_id=?",
                    (new_date, new_count, cid),
                )

                # Detect new comment(s)
                if old_date and new_date and new_date > old_date:
                    new_comments_count = new_count - old_count if new_count > old_count else 1
                    author = ci.get("latestAuthor", "Someone")
                    ehash = _event_hash(cid, "COMMENT", old_date, new_date)
                    existing = conn.execute("SELECT event_id FROM events WHERE event_hash=?", (ehash,)).fetchone()
                    if existing:
                        continue

                    log_info("new_comment_detected", case=num, ext=ext, by=author, new_comments=new_comments_count)

                    fetched = fetch_comments_hydra(ext)
                    comment_text = _format_comments(fetched)

                    case_row = conn.execute("SELECT subject, status FROM cases WHERE case_id=?", (cid,)).fetchone()
                    subject = case_row["subject"] if case_row else ""
                    cur_status = case_row["status"] if case_row else ""
                    link = f"https://redhatsupport.lightning.force.com/lightning/r/Case/{cid}/view"

                    conn.execute(
                        "INSERT INTO events (case_id, case_number, event_type, old_value, new_value, event_time, event_hash, details) "
                        "VALUES (?,?,?,?,?,?,?,?)",
                        (cid, num, "COMMENT", old_date, new_date, now, ehash,
                         f"{new_comments_count} new comment(s) by {author}"),
                    )
                    event_id = conn.execute("SELECT last_insert_rowid()").fetchone()[0]

                    title = f"New comment on Case {num}" + (f" ({new_comments_count} new)" if new_comments_count > 1 else "")
                    body = (
                        f"{'New comment' if new_comments_count == 1 else f'{new_comments_count} new comments'} on case {num}.\n"
                        f"By: {author}\nStatus: {cur_status}\n"
                        f"Subject: {subject}\n{link}\n{comment_text}\n"
                    )
                    queue_notification(conn, event_id, title, body)
                    stats["events"] += 1

    # 4b. For 077 cases (no Hydra), detect changes via "Last Modified Date" from list view
    #     If Last Modified changed but status didn't change, it's likely a new comment or update
    if initialized:
        for rec in cases:
            cid = rec.get("Id") or rec.get("CaseNumber") or ""
            if not cid:
                continue
            num = rec.get("CaseNumber", "")
            ext = rec.get("ExternalNumber", "") or num
            last_mod = rec.get("LastModified", "")
            status = rec.get("Status", "")
            owner = rec.get("OwnerAlias", "")

            # Only process 077 cases (045 cases already handled by Hydra above)
            if not ext.startswith("077"):
                continue
            # Owner filter
            if owner and SSH_USER and owner.lower() != SSH_USER.lower():
                continue
            # Skip if no Last Modified data (column not added to list view yet)
            if not last_mod:
                continue
            # Skip if status already changed (already notified above)
            if num in status_changed_cases:
                continue

            old = conn.execute("SELECT last_modified, status FROM cases WHERE case_id=?", (cid,)).fetchone()
            if not old or not old["last_modified"]:
                continue
            old_mod = old["last_modified"]
            old_st = old["status"]

            # If Last Modified changed but status didn't → likely a comment or field update
            if last_mod != old_mod and status.strip().lower() == old_st.strip().lower():
                ehash = _event_hash(cid, "MODIFIED", old_mod, last_mod)
                existing = conn.execute("SELECT event_id FROM events WHERE event_hash=?", (ehash,)).fetchone()
                if existing:
                    continue

                log_info("case_modified_detected", case=num, old_mod=old_mod, new_mod=last_mod)

                subject_text = rec.get("Subject", "")
                link = f"https://redhatsupport.lightning.force.com/lightning/r/Case/{cid}/view"

                conn.execute(
                    "INSERT INTO events (case_id, case_number, event_type, old_value, new_value, event_time, event_hash, details) "
                    "VALUES (?,?,?,?,?,?,?,?)",
                    (cid, num, "MODIFIED", old_mod, last_mod, now, ehash,
                     "Case modified (likely new comment or update)"),
                )
                event_id = conn.execute("SELECT last_insert_rowid()").fetchone()[0]

                title = f"Case {num} Updated"
                body = (
                    f"Case {num} was modified.\n"
                    f"Status: {status}\n"
                    f"Subject: {subject_text}\n"
                    f"Modified: {old_mod} -> {last_mod}\n"
                    f"{link}\n"
                )
                queue_notification(conn, event_id, title, body)
                stats["events"] += 1

    conn.commit()

    # 5. Dispatch all pending notifications
    pending = conn.execute(
        "SELECT notif_id FROM notifications WHERE status IN ('PENDING', 'RETRY')"
    ).fetchall()
    for row in pending:
        if dispatch_notification(conn, row["notif_id"]):
            stats["notifications"] += 1

    # 6. Mark initialized
    if not initialized:
        _db_set(conn, "initialized", "1")
        log_info("baseline_established", cases=len(cases))

    # 7. Write heartbeat + JSON compat for dashboard
    _write_heartbeat(len(cases), "OK")
    _write_json_compat(conn, columns)

    # 8. Record poll run
    conn.execute(
        "INSERT INTO poll_runs (started_at, finished_at, status, cases_found, events_found, notifs_sent) "
        "VALUES (?,?,?,?,?,?)",
        (run_start, datetime.now(timezone.utc).isoformat(), "OK", len(cases), stats["events"], stats["notifications"]),
    )
    conn.commit()

    status_changes = conn.execute(
        "SELECT COUNT(*) as c FROM events WHERE event_type='STATUS' AND event_time=?", (now,)
    ).fetchone()["c"]
    new_comments = conn.execute(
        "SELECT COUNT(*) as c FROM events WHERE event_type='COMMENT' AND event_time=?", (now,)
    ).fetchone()["c"]
    log_info("POLL_COMPLETE", cases=len(cases), status_changes=status_changes,
             new_comments=new_comments, notifications_sent=stats["notifications"])
    return stats


