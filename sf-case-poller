JSON_STATE_PATH = os.path.expanduser("~/.local/state/sf-case-status.json")
LOG_PATH = os.path.expanduser("~/Library/Logs/sf-case-poller.log")
HEARTBEAT_PATH = os.path.expanduser("~/.local/state/sf-poller-heartbeat.json")
