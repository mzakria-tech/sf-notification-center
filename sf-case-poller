def main() -> int:
    args = sys.argv[1:]
    cmd = args[0] if args else ""

    # Commands that don't need DB
    if cmd == "install":
        cmd_install()
        return 0
    if cmd == "uninstall":
        cmd_uninstall()
        return 0
    if cmd == "start":
        cmd_start()
        return 0
    if cmd == "stop":
        cmd_stop()
        return 0
    if cmd == "restart":
        cmd_restart()
        return 0
    if cmd == "logs":
        cmd_logs()
        return 0
    if cmd == "dashboard" or cmd == "web" or cmd == "open":
        cmd_dashboard()
        return 0
    if cmd in ("help", "--help", "-h", ""):
        print("SF Case Notification Center")
        print("")
        print("Setup:")
        print("  sf-case-poller install     Install and start (one-time)")
        print("  sf-case-poller uninstall   Remove everything")
        print("")
        print("Control:")
        print("  sf-case-poller start       Start poller")
        print("  sf-case-poller stop        Stop poller")
        print("  sf-case-poller restart     Restart poller")
        print("")
        print("Monitor:")
        print("  sf-case-poller status      Check status")
        print("  sf-case-poller health      Health check")
        print("  sf-case-poller dashboard   Open web dashboard in browser")
        print("  sf-case-poller logs        View live logs")
        print("  sf-case-poller history     Notification history")
        print("  sf-case-poller test-email  Test email delivery")
        return 0

    conn = _init_db()

    if cmd == "--status" or cmd == "status":
        cmd_status(conn)
        return 0

    if cmd == "--health" or cmd == "health":
        cmd_health(conn)
        return 0

    if cmd == "--test-email" or cmd == "test-email":
        cmd_test_email()
        return 0

    if cmd == "--test" or cmd == "test":
        cmd_health(conn)
        print()
        cmd_test_email()
        return 0

    if cmd == "--history" or cmd == "history":
        cmd_history(conn)
        return 0

    if cmd == "--once" or cmd == "once":
        log_info("poll_started", mode="once", url=CASE_LIST_URL[:80])
        stats = poll_once(conn)
        print(f"Poll complete: cases={stats['cases']} events={stats['events']} notifs={stats['notifications']} status={stats['status']}")
        return 0

    if cmd != "poll":
        print(f"Unknown command: {cmd}")
        print("Run: sf-case-poller help")
        return 1

    # Default: continuous polling
    log_info("service_started", interval=INTERVAL, url=CASE_LIST_URL[:80], pid=os.getpid())

    def _handle_signal(sig, frame):
        log_info("service_stopped", signal=sig)
        sys.exit(0)
    signal.signal(signal.SIGTERM, _handle_signal)
    signal.signal(signal.SIGINT, _handle_signal)

    # Startup reconciliation — if we haven't run in >15 min, re-baseline
    try:
        with open(HEARTBEAT_PATH) as f:
            hb = json.load(f)
        last = datetime.fromisoformat(hb["last_successful_poll"])
        gap = (datetime.now(timezone.utc) - last.replace(tzinfo=timezone.utc)).total_seconds()
        if gap > 900:
            log_warn("startup_reconciliation", gap_seconds=int(gap))
            _db_set(conn, "initialized", "0")
    except Exception:
        pass

    COMMENT_INTERVAL = 60   # Hydra comment check every 1 min (no Chrome)
    SCRAPE_INTERVAL = 300   # Full Chrome scrape every 5 min
    last_scrape = 0

    while True:
        now_ts = time.time()
        try:
            if now_ts - last_scrape >= SCRAPE_INTERVAL:
                # Full poll: Chrome scrape + status detection + comment check
                poll_once(conn)
                last_scrape = now_ts
            else:
                # Quick poll: Hydra-only comment check (no Chrome, zero disruption)
                _comment_only_check(conn)
            process_retry_queue(conn)
        except Exception as exc:
            log_error("poll_error", error=str(exc)[:200])
        time.sleep(COMMENT_INTERVAL)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        log_info("stopped", reason="keyboard_interrupt")
    except Exception as exc:
        log_error("fatal", error=str(exc)[:200])
        sys.exit(1)
