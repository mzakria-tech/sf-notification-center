# ─── Structured Logging ────────────────────────────────────────────────────
def log(level: str, msg: str, **kv) -> None:
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    extra = " ".join(f"{k}={v}" for k, v in kv.items()) if kv else ""
    line = f"{ts} {level:<5} {msg}" + (f" {extra}" if extra else "")
    os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
    with open(LOG_PATH, "a", encoding="utf-8") as fh:
        fh.write(line + "\n")

def log_info(msg, **kv):  log("INFO", msg, **kv)
def log_warn(msg, **kv):  log("WARN", msg, **kv)
def log_error(msg, **kv): log("ERROR", msg, **kv)

# ─── SQLite Database ───────────────────────────────────────────────────────
def _init_db() -> sqlite3.Connection:
    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.executescript("""
        CREATE TABLE IF NOT EXISTS cases (
            case_id         TEXT PRIMARY KEY,
            case_number     TEXT,
            external_number TEXT,
            status          TEXT,
            subject         TEXT,
            owner_alias     TEXT,
            fields_json     TEXT,
            last_modified   TEXT,
            last_comment_id TEXT,
            last_comment_date TEXT,
            comment_count   INTEGER DEFAULT 0,
            first_seen      TEXT,
            last_seen       TEXT
        );

        CREATE TABLE IF NOT EXISTS events (
            event_id    INTEGER PRIMARY KEY AUTOINCREMENT,
            case_id     TEXT,
            case_number TEXT,
            event_type  TEXT,
            old_value   TEXT,
            new_value   TEXT,
            event_time  TEXT,
            event_hash  TEXT UNIQUE,
            details     TEXT,
            processed   INTEGER DEFAULT 0
        );

        CREATE TABLE IF NOT EXISTS notifications (
            notif_id    INTEGER PRIMARY KEY AUTOINCREMENT,
            event_id    INTEGER REFERENCES events(event_id),
            channel     TEXT,
            subject     TEXT,
            body        TEXT,
            status      TEXT DEFAULT 'PENDING',
            retry_count INTEGER DEFAULT 0,
            created_at  TEXT,
            sent_at     TEXT,
            last_error  TEXT
        );

        CREATE TABLE IF NOT EXISTS poll_runs (
            run_id      INTEGER PRIMARY KEY AUTOINCREMENT,
            started_at  TEXT,
            finished_at TEXT,
            status      TEXT,
            cases_found INTEGER DEFAULT 0,
            events_found INTEGER DEFAULT 0,
            notifs_sent INTEGER DEFAULT 0,
            error       TEXT
        );

        CREATE TABLE IF NOT EXISTS meta (
            key   TEXT PRIMARY KEY,
            value TEXT
        );
    """)
    conn.execute("INSERT OR IGNORE INTO meta (key, value) VALUES ('initialized', '0')")
    conn.commit()
    return conn


def _db_get(conn, key: str) -> str:
    row = conn.execute("SELECT value FROM meta WHERE key=?", (key,)).fetchone()
    return row["value"] if row else ""


def _db_set(conn, key: str, value: str):
    conn.execute("INSERT OR REPLACE INTO meta (key, value) VALUES (?, ?)", (key, value))
    conn.commit()


# ─── Circuit Breaker ───────────────────────────────────────────────────────
class CircuitBreaker:
    def __init__(self):
        self.failures = 0
        self.opened_at = 0.0

    def record_failure(self):
        self.failures += 1
        if self.failures >= CB_THRESHOLD:
            self.opened_at = time.time()
            log_warn("circuit_breaker_open", failures=self.failures)

    def record_success(self):
        if self.failures > 0:
            log_info("circuit_breaker_reset")
        self.failures = 0
        self.opened_at = 0.0

    @property
    def is_open(self) -> bool:
        if self.failures < CB_THRESHOLD:
            return False
        if time.time() - self.opened_at > CB_RESET_SECONDS:
            log_info("circuit_breaker_half_open", testing="yes")
            return False
        return True

ssh_circuit = CircuitBreaker()

# ─── Event Hashing ─────────────────────────────────────────────────────────
def _event_hash(case_id: str, event_type: str, old_val: str, new_val: str) -> str:
    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    raw = f"{case_id}|{event_type}|{old_val}|{new_val}|{today}"
    return hashlib.sha256(raw.encode()).hexdigest()[:16]


# ─── Notifications ─────────────────────────────────────────────────────────
def _as_safe(s: str) -> str:
    """Sanitize text for AppleScript (ASCII only)."""
    s = s.replace("\\", "/").replace('"', "'").replace("\u2192", "->")
    return "".join(c if ord(c) < 128 else "?" for c in s)


def _send_smtp(subject: str, body: str) -> bool:
    try:
        msg = MIMEText(body)
        msg["Subject"] = subject
        msg["From"] = "sf-notify@localhost"
        msg["To"] = TO_ADDR
        with smtplib.SMTP("127.0.0.1", 2525, timeout=5) as s:
            s.send_message(msg)
        return True
    except Exception as exc:
        log_warn("smtp_failed", error=str(exc)[:120])
        return False


def _send_mailapp(subject: str, body: str) -> bool:
    if not TO_ADDR:
        return True
    content = body if body.endswith("\n") else body + "\n"
    safe_subj = _as_safe(subject)
    safe_body = _as_safe(content)
    ascript = (
        'tell application "Mail"\n'
        f'  set m to make new outgoing message with properties '
        f'{{subject:"{safe_subj}", content:"{safe_body}", visible:false}}\n'
        f'  tell m\n'
        f'    make new to recipient at end of to recipients with properties '
        f'{{address:"{TO_ADDR}"}}\n'
        f'  end tell\n'
        f'  send m\n'
        f'end tell\n'
    )
    fd, path = tempfile.mkstemp(suffix=".applescript")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(ascript)
        r = subprocess.run(["osascript", path], capture_output=True, text=True, timeout=15)
    finally:
        os.unlink(path)
    if r.returncode != 0:
        log_warn("mailapp_failed", error=(r.stderr or "").strip()[:120])
        return False
    return True


def _send_banner(title: str, body: str):
    subprocess.run(
        ["osascript", "-e",
         f'display notification {json.dumps(body[:100])} with title {json.dumps(title[:60])}'],
        check=False, capture_output=True,
    )


def dispatch_notification(conn: sqlite3.Connection, notif_id: int) -> bool:
    """Attempt to send a queued notification. Returns True on success."""
    row = conn.execute("SELECT * FROM notifications WHERE notif_id=?", (notif_id,)).fetchone()
    if not row:
        return False
    subject, body, channel = row["subject"], row["body"], row["channel"]
    now = datetime.now(timezone.utc).isoformat()

    ok = False
    if channel == "smtp":
        ok = _send_smtp(subject, body)
    elif channel == "mailapp":
        ok = _send_mailapp(subject, body)
    elif channel == "banner":
        _send_banner(subject, body)
        ok = True

    if ok:
        conn.execute("UPDATE notifications SET status='SENT', sent_at=? WHERE notif_id=?", (now, notif_id))
    else:
        retries = row["retry_count"] + 1
        status = "FAILED" if retries > len(RETRY_DELAYS) else "RETRY"
        conn.execute(
            "UPDATE notifications SET status=?, retry_count=?, last_error=? WHERE notif_id=?",
            (status, retries, f"attempt {retries} failed", notif_id),
        )
    conn.commit()
    return ok


def queue_notification(conn: sqlite3.Connection, event_id: int, subject: str, body: str):
    """Queue notifications across all channels."""
    now = datetime.now(timezone.utc).isoformat()
    for channel in ("smtp", "mailapp", "banner"):
        conn.execute(
            "INSERT INTO notifications (event_id, channel, subject, body, created_at) VALUES (?,?,?,?,?)",
            (event_id, channel, subject, body, now),
        )
    conn.commit()


def process_retry_queue(conn: sqlite3.Connection) -> int:
    """Retry failed notifications that are due."""
    rows = conn.execute(
        "SELECT notif_id, retry_count, created_at FROM notifications WHERE status='RETRY'"
    ).fetchall()
    retried = 0
    for row in rows:
        idx = min(row["retry_count"], len(RETRY_DELAYS) - 1)
        delay = RETRY_DELAYS[idx]
        created = datetime.fromisoformat(row["created_at"])
        age = (datetime.now(timezone.utc) - created.replace(tzinfo=timezone.utc)).total_seconds()
        if age >= delay * (row["retry_count"]):
            if dispatch_notification(conn, row["notif_id"]):
                retried += 1
    return retried


# ─── Heartbeat ─────────────────────────────────────────────────────────────
def _write_heartbeat(cases: int, status: str, error: str = ""):
    data = {
        "last_successful_poll": datetime.now(timezone.utc).isoformat(),
        "cases": cases,
        "status": status,
        "error": error,
        "pid": os.getpid(),
    }
    os.makedirs(os.path.dirname(HEARTBEAT_PATH), exist_ok=True)
    with open(HEARTBEAT_PATH, "w") as f:
        json.dump(data, f, indent=2)


# ─── Chrome / Salesforce Scraping ─────────────────────────────────────────
def _run_applescript(ascript: str, timeout: int = 45) -> str:
    fd, path = tempfile.mkstemp(suffix=".applescript")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(ascript)
        r = subprocess.run(["osascript", path], capture_output=True, text=True, timeout=timeout)
    finally:
        os.unlink(path)
    if r.returncode != 0:
        raise RuntimeError(f"AppleScript failed: {(r.stderr or '').strip()[:300]}")
    return (r.stdout or "").strip()


def chrome_js(js_code: str, need_all_rows: bool = False) -> str:
    """Execute JS in Chrome's Salesforce tab.

    need_all_rows=False: pure background read — never activates anything.
    need_all_rows=True:  if Chrome is NOT the frontmost app (user is in another app),
                         briefly switch tabs to render virtual rows — completely invisible
                         since Chrome is behind other windows. If Chrome IS frontmost,
                         stays in background mode to avoid visual disruption.
    """
    b64 = base64.b64encode(js_code.encode("utf-8")).decode("ascii")
    exec_line = f'execute javascript "eval(atob(\'{b64}\'))"'

    if need_all_rows:
        # Proven approach: activate tab, navigate to list view, scroll, scrape, restore
        ascript = f'''
tell application "Google Chrome"
    set sfTab to missing value
    set sfWin to missing value
    set sfTabIdx to 0
    repeat with w in windows
        repeat with i from 1 to count of tabs of w
            set t to tab i of w
            if URL of t contains "lightning" and URL of t contains "redhatsupport" then
                set sfTab to t
                set sfWin to w
                set sfTabIdx to i
                exit repeat
            end if
        end repeat
        if sfTab is not missing value then exit repeat
    end repeat
    if sfTab is missing value then
        tell window 1
            set sfTab to make new tab with properties {{URL:"{CASE_LIST_URL}"}}
            set sfWin to window 1
            set sfTabIdx to (count of tabs of window 1)
        end tell
        delay 15
    else
        set curURL to URL of sfTab
        if curURL does not contain "{CASE_LIST_URL}" then
            set URL of sfTab to "{CASE_LIST_URL}"
            delay 12
        end if
    end if
    set origIdx to active tab index of sfWin
    set active tab index of sfWin to sfTabIdx
    delay 5
    tell sfTab
        set r to {exec_line}
    end tell
    set active tab index of sfWin to origIdx
    return r
end tell
'''
    else:
        ascript = f'''
tell application "Google Chrome"
    set sfTab to missing value
    repeat with w in windows
        repeat with i from 1 to count of tabs of w
            set t to tab i of w
            if URL of t contains "lightning" and URL of t contains "redhatsupport" then
                set sfTab to t
                exit repeat
            end if
        end repeat
        if sfTab is not missing value then exit repeat
    end repeat
    if sfTab is missing value then
        return "ERROR:NO_SF_TAB"
    end if
    tell sfTab
        set r to {exec_line}
    end tell
    return r
end tell
'''
    return _run_applescript(ascript)



def scrape_cases() -> tuple[list[dict], list[str]]:
    if not CASE_LIST_URL:
        raise RuntimeError("No case list URL configured — set it in the dashboard at http://localhost:8090")

    # Try quiet first (no tab switch, no activation, zero disruption)
    cases, columns = _do_scrape(need_all_rows=False)
    if len(cases) >= 3:
        log_info("scrape_mode", mode="background_quiet", activation="NO", cases=len(cases))
        return cases, columns

    # Fallback: activate tab only if quiet got too few rows
    log_warn("scrape_quiet_insufficient", rows=len(cases))
    cases, columns = _do_scrape(need_all_rows=True)
    log_info("scrape_mode", mode="activated_fallback", cases=len(cases))
    return cases, columns


def _do_scrape(need_all_rows: bool = False) -> tuple[list[dict], list[str]]:
    # Build JS based on mode:
    # need_all_rows=False: pure DOM read, no scrolling
    # need_all_rows=True: scroll to force virtual rows to render (tab is active)
    scroll_js = ""
    if need_all_rows:
        scroll_js = r"""
        var scrollContainers = document.querySelectorAll('.uiScroller, .slds-scrollable_y, .slds-scrollable, [role="grid"], .listViewContent');
        for (var si = 0; si < scrollContainers.length; si++) {
            var sc = scrollContainers[si];
            if (sc.scrollHeight > sc.clientHeight) {
                for (var step = 0; step < 25; step++) {
                    sc.scrollTop = step * 200;
                    var tw = Date.now(); while (Date.now() - tw < 150) {}
                }
                sc.scrollTop = 0;
                var tw2 = Date.now(); while (Date.now() - tw2 < 300) {}
            }
        }
        for (var ps = 0; ps < 10; ps++) {
            window.scrollTo(0, ps * 300);
            var tw3 = Date.now(); while (Date.now() - tw3 < 150) {}
        }
        window.scrollTo(0, 0);
        var tw10 = Date.now(); while (Date.now() - tw10 < 500) {}

        // Wait for virtual rows to render (up to 10s)
        var maxWait = 10000, waited = 0;
        while (waited < maxWait) {
            var checkRows = document.querySelectorAll('table tbody tr');
            if (expected > 0 && checkRows.length >= expected) break;
            if (checkRows.length >= 3 && waited > 3000) break;
            if (waited % 2000 === 0 && waited > 0) {
                window.scrollTo(0, document.body.scrollHeight);
                var rs = Date.now(); while (Date.now() - rs < 200) {}
                window.scrollTo(0, 0);
            }
            var t = Date.now(); while (Date.now() - t < 500) {}
            waited += 500;
        }
        """
    js = r"""
    (function() {
        var expected = 0;
        var allEls = document.querySelectorAll('span, div, p');
        for (var hh = 0; hh < allEls.length; hh++) {
            var ht = allEls[hh].textContent || '';
            var em = ht.match(/(\d+)\s+items?/i);
            if (em && ht.length < 150) { expected = parseInt(em[1]); break; }
        }
        """ + scroll_js + r"""
        var rows = document.querySelectorAll('table tbody tr');
        if (rows.length === 0) rows = document.querySelectorAll('[data-row-key-value]');
        if (rows.length === 0) rows = document.querySelectorAll('table tr');
        if (rows.length === 0) rows = document.querySelectorAll('[role="row"]');
        if (rows.length === 0) rows = document.querySelectorAll('.slds-table tr, .forceListViewManager tr, lightning-datatable tr');
        var columns = [];
        if (rows.length > 0) {
            var firstCells = rows[0].querySelectorAll('td, th');
            for (var fc = 0; fc < firstCells.length; fc++) {
                var lbl = firstCells[fc].getAttribute('data-label') || '';
                if (lbl && lbl.length > 0) columns.push(lbl);
            }
        }
        if (columns.length === 0) {
            var ths = document.querySelectorAll('table thead th, [role="columnheader"]');
            for (var th = 0; th < ths.length; th++) {
                var al = ths[th].getAttribute('aria-label') || '';
                if (al && al.length > 0 && al.length < 50) columns.push(al);
            }
        }
        var cases = [];
        for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            if (row.querySelector('th[scope="col"]')) continue;
            if (row.parentElement && row.parentElement.tagName === 'THEAD') continue;
            var cells = row.querySelectorAll('td, th');
            var fields = {};
            var hasDataLabel = false;
            for (var j = 0; j < cells.length; j++) {
                var label = cells[j].getAttribute('data-label') || '';
                if (label) { hasDataLabel = true; fields[label] = cells[j].textContent.trim(); }
            }
            if (!hasDataLabel && columns.length > 0) {
                var ci = 0;
                for (var j = 0; j < cells.length; j++) {
                    var val = cells[j].textContent.trim();
                    if (val && ci < columns.length) { fields[columns[ci]] = val; ci++; }
                }
            }
            var link = row.querySelector('a[href*="/view"], a[href*="/Case/"]');
            var caseId = '';
            if (link) {
                var m = link.href.match(/\/r\/([a-zA-Z0-9]{15,18})\/view/) || link.href.match(/Case\/([a-zA-Z0-9]{15,18})/);
                if (m) caseId = m[1];
            }
            if (!caseId) caseId = row.getAttribute('data-row-key-value') || '';
            // Extract BOTH external and internal case numbers
            var extNum = '';
            var intNum = '';
            for (var key in fields) {
                var v = fields[key];
                if (/^\d{5,10}$/.test(v)) {
                    if (/^internal/i.test(key)) {
                        intNum = v;
                    } else if (/case.?number/i.test(key)) {
                        extNum = v;
                    }
                }
            }
            // Prefer external number (045xxxxx) for Hydra API compatibility
            var caseNum = extNum || intNum || '';
            if (!caseNum) {
                for (var key in fields) {
                    var vm = fields[key].match(/\b(\d{7,8})\b/);
                    if (vm) { caseNum = vm[1]; break; }
                }
            }
            if (caseNum || caseId) cases.push({ id: caseId, caseNum: caseNum, extNum: extNum, intNum: intNum, fields: fields });
        }
        var tableCount = document.querySelectorAll('table').length;
        var allTrCount = document.querySelectorAll('tr').length;
        return JSON.stringify({
            cases: cases, columns: columns, url: window.location.href,
            title: document.title, count: cases.length,
            debug: {expected: expected, tables: tableCount, allTrs: allTrCount, rowsFound: rows.length}
        });
    })()
    """
    result = chrome_js(js, need_all_rows=need_all_rows)
    if not result or result.startswith("ERROR:"):
        raise RuntimeError(f"Chrome JS returned: {result}")
    try:
        data = json.loads(result)
    except json.JSONDecodeError:
        raise RuntimeError(f"Could not parse case list data: {result[:200]}")

    page_url = data.get("url", "")
    if "login" in page_url.lower() or "auth" in page_url.lower():
        raise RuntimeError("Session expired — log in to Salesforce in Chrome first")

    columns = data.get("columns", [])
    debug = data.get("debug", {})
    log_info("scrape_complete", page=data.get("title", "?"), cases=data.get("count", 0),
             columns=len(columns), expected=debug.get("expected", 0), rows=debug.get("rowsFound", 0))

    cases = []
    for row in data.get("cases", []):
        case_id = row.get("id", "")
        case_num = row.get("caseNum", "")
        ext_num = row.get("extNum", "")
        int_num = row.get("intNum", "")
        fields = row.get("fields", {})
        if not case_num and not case_id:
            continue
        # Extract Last Modified Date for change detection (works for ALL cases)
        last_mod = ""
        for k, v in fields.items():
            if "last modified" in k.lower() or "lastmodified" in k.lower():
                last_mod = v.strip()
                break
        cases.append({
            "Id": case_id, "CaseNumber": case_num,
            "ExternalNumber": ext_num,
            "InternalNumber": int_num,
            "Status": fields.get("Status", ""),
            "Subject": fields.get("Subject", ""),
            "OwnerAlias": fields.get("Case Owner Alias", ""),
            "LastModified": last_mod,
            "fields": fields,
        })
    return cases, columns


# ─── Hydra API (Support Shell) ─────────────────────────────────────────────
def _ssh_python(script: str, timeout: int = 30) -> str:
    """Run a Python script on Support Shell via SSH. Respects circuit breaker."""
    if ssh_circuit.is_open:
        log_warn("ssh_skipped", reason="circuit_breaker_open")
        return ""
    if not SSH_USER:
        log_warn("ssh_skipped", reason="no_ssh_user")
        return ""
    try:
        r = subprocess.run(
            ["ssh", f"{SSH_USER}@{SUPPORTSHELL_HOST}", "python3"],
            input=script, capture_output=True, text=True, timeout=timeout,
        )
        if r.returncode != 0:
            ssh_circuit.record_failure()
            log_error("ssh_failed", exit=r.returncode, stderr=(r.stderr or "").strip()[:200])
            return ""
        ssh_circuit.record_success()
        return (r.stdout or "").strip()
    except Exception as exc:
        ssh_circuit.record_failure()
        log_error("ssh_exception", error=str(exc)[:120])
        return ""


def fetch_comments_hydra(case_number: str) -> list[dict]:
    """Fetch full comments for a single case via Red Hat GraphQL API."""
    script = f'''
import json, urllib.request, urllib.parse, os
try:
    gql_file = os.path.expanduser("~/.cache/hydra-mcp/tokens/redhat-sso-token.json")
    if not os.path.exists(gql_file):
        gql_file = "/home/remote/{SSH_USER}/.yank/oidc-tokens.json"
    with open(gql_file) as f:
        d = json.load(f)
    data = urllib.parse.urlencode({{
        "grant_type": "refresh_token",
        "refresh_token": d["refresh_token"],
        "client_id": "cee-supportshell-deviceauth"
    }}).encode()
