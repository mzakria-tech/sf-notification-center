def cmd_health(conn: sqlite3.Connection):
    """Run health checks."""
    checks = []

    # Salesforce / Chrome
    try:
        r = subprocess.run(["pgrep", "-x", "Google Chrome"], capture_output=True)
        checks.append(("Chrome", "PASS" if r.returncode == 0 else "FAIL"))
    except Exception:
        checks.append(("Chrome", "FAIL"))

    # Mail.app
    try:
        r = subprocess.run(["pgrep", "-x", "Mail"], capture_output=True)
        checks.append(("Mail.app", "PASS" if r.returncode == 0 else "WARN (not running)"))
    except Exception:
        checks.append(("Mail.app", "WARN"))

    # SMTP
    try:
        with smtplib.SMTP("127.0.0.1", 2525, timeout=3) as s:
            s.noop()
        checks.append(("Local SMTP", "PASS"))
    except Exception:
        checks.append(("Local SMTP", "FAIL (port 2525)"))

    # SSH / Hydra
    if ssh_circuit.is_open:
        checks.append(("SSH/Hydra", "FAIL (circuit open)"))
    elif SSH_USER:
        try:
            r = subprocess.run(
                ["ssh", "-o", "ConnectTimeout=5", f"{SSH_USER}@{SUPPORTSHELL_HOST}", "echo ok"],
                capture_output=True, text=True, timeout=10,
            )
            checks.append(("SSH/Hydra", "PASS" if r.returncode == 0 else "FAIL"))
        except Exception:
            checks.append(("SSH/Hydra", "FAIL"))
    else:
        checks.append(("SSH/Hydra", "SKIP (no user)"))

    # SQLite
    try:
        conn.execute("SELECT 1").fetchone()
        checks.append(("SQLite DB", "PASS"))
    except Exception:
        checks.append(("SQLite DB", "FAIL"))

    # Dashboard
    try:
        import urllib.request
        r = urllib.request.urlopen("http://localhost:8090", timeout=3)
        checks.append(("Dashboard", "PASS" if r.status == 200 else "FAIL"))
    except Exception:
        checks.append(("Dashboard", "FAIL (port 8090)"))

    # Heartbeat freshness
    try:
        with open(HEARTBEAT_PATH) as f:
            hb = json.load(f)
        last = datetime.fromisoformat(hb["last_successful_poll"])
        age = (datetime.now(timezone.utc) - last.replace(tzinfo=timezone.utc)).total_seconds()
        checks.append(("Heartbeat", f"PASS ({int(age)}s ago)" if age < 600 else f"WARN ({int(age)}s stale)"))
    except Exception:
        checks.append(("Heartbeat", "FAIL (no data)"))

    # Case list URL
    checks.append(("Case List URL", "PASS" if CASE_LIST_URL else "FAIL (not set)"))

    print("═══ Health Check ═══")
    all_pass = True
    for name, result in checks:
        symbol = "✓" if result.startswith("PASS") else ("⚠" if result.startswith("WARN") or result.startswith("SKIP") else "✗")
        print(f"  {symbol} {name:<20} {result}")
        if result.startswith("FAIL"):
            all_pass = False
    print(f"\n  Overall: {'HEALTHY' if all_pass else 'DEGRADED'}")


