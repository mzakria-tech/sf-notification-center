#!/usr/bin/env python3
"""Poll Salesforce case status via Chrome AppleScript.

Uses the running Chrome's logged-in session directly.
Runs every INTERVAL seconds, emails on any status change.

State: ~/.local/state/sf-case-status.json
Log:   ~/Library/Logs/sf-case-poller.log
"""
from __future__ import annotations

import json
import os
import re
import smtplib
import subprocess
import sys
import time
from datetime import datetime, timezone
from email.mime.text import MIMEText

INTERVAL = int(os.environ.get("SF_POLL_INTERVAL", "300"))  # 5 min default
STATE_PATH = os.path.expanduser("~/.local/state/sf-case-status.json")
LOG_PATH = os.path.expanduser("~/Library/Logs/sf-case-poller.log")
def _get_notify_email() -> str:
    env = os.environ.get("SF_NOTIFY_EMAIL")
    if env:
        return env
    try:
        with open(CONFIG_PATH) as f:
            return json.load(f).get("notify_email", "")
    except Exception:
        return ""

TO_ADDR = _get_notify_email()
CONFIG_PATH = os.path.expanduser("~/.local/state/sf-poller-config.json")

def _get_case_list_url() -> str:
    """Read case list URL: env var > config file > default."""
    env = os.environ.get("SF_CASE_LIST_URL")
    if env:
        return env
    try:
        with open(CONFIG_PATH) as f:
            return json.load(f).get("case_list_url", "")
    except Exception:
        pass
    return ""

CASE_LIST_URL = _get_case_list_url()


def log(msg: str) -> None:
    line = f"{datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} {msg}"
    os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
    with open(LOG_PATH, "a", encoding="utf-8") as fh:
        fh.write(line + "\n")


def send_mail(subject: str, body: str) -> None:
    # 1. Local SMTP for web UI
    try:
        msg = MIMEText(body)
        msg["Subject"] = subject
        msg["From"] = "sf-notify@localhost"
        msg["To"] = TO_ADDR
        with smtplib.SMTP("127.0.0.1", 2525, timeout=5) as s:
            s.send_message(msg)
    except Exception as exc:
        log(f"local smtp skipped: {exc}")

    # 2. Real email via macOS Mail.app
    content = body if body.endswith("\n") else body + "\n"
    script = f"""
tell application "Mail"
  set m to make new outgoing message with properties {{subject:{json.dumps(subject)}, content:{json.dumps(content)}, visible:false}}
  tell m
    make new to recipient at end of to recipients with properties {{address:{json.dumps(TO_ADDR)}}}
  end tell
  send m
end tell
"""
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if r.returncode != 0:
        log(f"Mail.app send failed: {(r.stderr or r.stdout or '').strip()[:200]}")


def notify_banner(title: str, body: str) -> None:
    subprocess.run(
        ["osascript", "-e",
         f'display notification {json.dumps(body)} with title {json.dumps(title)}'],
        check=False,
    )


def load_state() -> dict:
    if not os.path.exists(STATE_PATH):
        return {"cases": {}, "initialized": False}
    with open(STATE_PATH, encoding="utf-8") as fh:
        return json.load(fh)


def save_state(state: dict) -> None:
    os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
    tmp = STATE_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(state, fh, indent=2)
    os.replace(tmp, STATE_PATH)


def chrome_js(js_code: str, url: str | None = None) -> str:
    """Execute JavaScript in Chrome via AppleScript. Returns the result as string."""
    import base64
    import tempfile

    # Base64 encode the JS to avoid quote escaping issues
    b64 = base64.b64encode(js_code.encode("utf-8")).decode("ascii")
    exec_line = f'execute javascript "eval(atob(\'{b64}\'))"'

    if url:
        ascript = f'''
tell application "Google Chrome"
    set sfTab to missing value
    set sfWin to missing value
    set sfTabIdx to 0
    repeat with w in windows
        repeat with i from 1 to count of tabs of w
            set t to tab i of w
            if URL of t contains "lightning" and URL of t contains "redhatsupport" then
                set sfTab to t
                set sfWin to w
                set sfTabIdx to i
                exit repeat
            end if
        end repeat
        if sfTab is not missing value then exit repeat
    end repeat
    if sfTab is missing value then
        tell window 1
            set sfTab to make new tab with properties {{URL:"{url}"}}
            set sfWin to window 1
            set sfTabIdx to (count of tabs of window 1)
        end tell
        delay 15
    else
        -- Only navigate if not already on the correct view
        set curURL to URL of sfTab
        if curURL does not contain "{url}" then
            set URL of sfTab to "{url}"
            delay 12
        end if
    end if
    -- Briefly activate SF tab so Chrome renders all virtual rows
    set origIdx to active tab index of sfWin
    set active tab index of sfWin to sfTabIdx
    delay 5
    tell sfTab
        set r to {exec_line}
    end tell
    -- Restore user's original tab
    set active tab index of sfWin to origIdx
    return r
end tell
'''
    else:
        ascript = f'''
tell application "Google Chrome"
    set sfTab to missing value
    repeat with w in windows
        repeat with t in tabs of w
            if URL of t starts with "https://redhatsupport" then
                set sfTab to t
                exit repeat
            end if
        end repeat
        if sfTab is not missing value then exit repeat
    end repeat
    if sfTab is missing value then
        return "ERROR:NO_SF_TAB"
    end if
    tell sfTab
        set r to {exec_line}
    end tell
    return r
end tell
'''

    # Write AppleScript to temp file to avoid shell quoting issues
    fd, path = tempfile.mkstemp(suffix=".applescript")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(ascript)
        r = subprocess.run(
            ["osascript", path],
            capture_output=True, text=True, timeout=45,
        )
    finally:
        os.unlink(path)

    if r.returncode != 0:
        err = (r.stderr or "").strip()
        raise RuntimeError(f"AppleScript failed: {err[:300]}")
    return (r.stdout or "").strip()


def scrape_cases():
    """Navigate Chrome to the case list, extract cases + recent comments via JS."""
    if not CASE_LIST_URL:
        raise RuntimeError("No case list URL configured — set it in the dashboard at http://localhost:8090")
    js = """
    (function() {
        // Get expected row count from the header (e.g. "18 items")
        var expected = 0;
        var allEls = document.querySelectorAll('span, div, p');
        for (var hh = 0; hh < allEls.length; hh++) {
            var ht = allEls[hh].textContent || '';
            var em = ht.match(/(\\d+)\\s+items?/i);
            if (em && ht.length < 150) { expected = parseInt(em[1]); break; }
        }

        // Scroll through the table to force all virtual rows to render
        var scrollContainers = document.querySelectorAll('.uiScroller, .slds-scrollable_y, .slds-scrollable, [role="grid"], .listViewContent');
        for (var si = 0; si < scrollContainers.length; si++) {
            var sc = scrollContainers[si];
            if (sc.scrollHeight > sc.clientHeight) {
                for (var step = 0; step < 20; step++) {
                    sc.scrollTop = step * 200;
                    var tw = Date.now(); while (Date.now() - tw < 150) {}
                }
                sc.scrollTop = 0;
                var tw2 = Date.now(); while (Date.now() - tw2 < 300) {}
            }
        }
        // Also scroll main page
        for (var ps = 0; ps < 10; ps++) {
            window.scrollTo(0, ps * 300);
            var tw3 = Date.now(); while (Date.now() - tw3 < 150) {}
        }
        window.scrollTo(0, 0);
        var tw4 = Date.now(); while (Date.now() - tw4 < 500) {}

        // Wait for rows to appear (up to 15s)
        var maxWait = 15000, waited = 0;
        while (waited < maxWait) {
            var r = document.querySelectorAll('table tbody tr');
            if (expected > 0 && r.length >= expected) break;
            if (r.length >= 3 && waited > 5000) break;
            // Re-scroll to trigger virtual rendering
            if (waited % 2000 === 0) {
                window.scrollTo(0, document.body.scrollHeight);
                var rs = Date.now(); while (Date.now() - rs < 200) {}
                window.scrollTo(0, 0);
            }
            var t = Date.now(); while (Date.now() - t < 500) {}
            waited += 500;
        }

        // Try multiple selectors to find table rows
        var rows = document.querySelectorAll('table tbody tr');
        if (rows.length === 0) rows = document.querySelectorAll('[data-row-key-value]');
        if (rows.length === 0) rows = document.querySelectorAll('table tr');
        if (rows.length === 0) rows = document.querySelectorAll('[role="row"]');
        if (rows.length === 0) rows = document.querySelectorAll('.slds-table tr, .forceListViewManager tr, lightning-datatable tr');

        // Discover columns dynamically from data-label or header
        var columns = [];
        if (rows.length > 0) {
            var firstCells = rows[0].querySelectorAll('td, th');
            for (var fc = 0; fc < firstCells.length; fc++) {
                var lbl = firstCells[fc].getAttribute('data-label') || '';
                if (lbl && lbl.length > 0) columns.push(lbl);
            }
        }
        // If no data-label, try getting columns from thead
        if (columns.length === 0) {
            var ths = document.querySelectorAll('table thead th, [role="columnheader"]');
            for (var th = 0; th < ths.length; th++) {
                var al = ths[th].getAttribute('aria-label') || '';
                if (al && al.length > 0 && al.length < 50) columns.push(al);
            }
        }

        var cases = [];
        for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            // Skip header rows
            if (row.querySelector('th[scope="col"]')) continue;
            if (row.parentElement && row.parentElement.tagName === 'THEAD') continue;

            var cells = row.querySelectorAll('td, th');

            // Build dynamic field map from data-label
            var fields = {};
            var hasDataLabel = false;
            for (var j = 0; j < cells.length; j++) {
                var label = cells[j].getAttribute('data-label') || '';
                if (label) {
                    hasDataLabel = true;
                    fields[label] = cells[j].textContent.trim();
                }
            }

            // Fallback: map cells to column headers by index
            if (!hasDataLabel && columns.length > 0) {
                var ci = 0;
                for (var j = 0; j < cells.length; j++) {
                    var val = cells[j].textContent.trim();
                    if (val && ci < columns.length) {
                        fields[columns[ci]] = val;
                        ci++;
                    }
                }
            }

            // Get Salesforce record ID from any link
            var link = row.querySelector('a[href*="/view"], a[href*="/Case/"]');
            var caseId = '';
            if (link) {
                var m = link.href.match(/\\/r\\/([a-zA-Z0-9]{15,18})\\/view/) || link.href.match(/Case\\/([a-zA-Z0-9]{15,18})/);
                if (m) caseId = m[1];
            }
            if (!caseId) caseId = row.getAttribute('data-row-key-value') || '';

            // Find case number — try various field name patterns
            var caseNum = '';
            for (var key in fields) {
                if (/case.?number/i.test(key) || /internal.?case/i.test(key)) {
                    var v = fields[key];
                    if (/^\\d{5,10}$/.test(v)) { caseNum = v; break; }
                }
            }
            // Last resort: find any 7-8 digit number in the row
            if (!caseNum) {
                for (var key in fields) {
                    var vm = fields[key].match(/\\b(\\d{7,8})\\b/);
                    if (vm) { caseNum = vm[1]; break; }
                }
            }

            if (caseNum || caseId) {
                cases.push({
                    id: caseId,
                    caseNum: caseNum,
                    fields: fields
                });
            }
        }

        // Debug info
        var tableCount = document.querySelectorAll('table').length;
        var allTrCount = document.querySelectorAll('tr').length;

        return JSON.stringify({
            cases: cases,
            columns: columns,
            url: window.location.href,
            title: document.title,
            count: cases.length,
            debug: {expected: expected, tables: tableCount, allTrs: allTrCount, rowsFound: rows.length}
        });
    })()
    """
    result = chrome_js(js, url=CASE_LIST_URL)
    if not result or result.startswith("ERROR:"):
        raise RuntimeError(f"Chrome JS returned: {result}")

    try:
        data = json.loads(result)
    except json.JSONDecodeError:
        log(f"JS returned non-JSON: {result[:200]}")
        raise RuntimeError("Could not parse case list data from Chrome")

    page_url = data.get("url", "")
    if "login" in page_url.lower() or "auth" in page_url.lower():
        raise RuntimeError("Session expired — log in to Salesforce in Chrome first")

    columns = data.get("columns", [])
    debug = data.get("debug", {})
    log(f"page: {data.get('title', '?')}, cases: {data.get('count', 0)}, columns: {columns}, debug: {debug}")

    cases = []
    for row in data.get("cases", []):
        case_id = row.get("id", "")
        case_num = row.get("caseNum", "")
        fields = row.get("fields", {})
        if not case_num and not case_id:
            continue
        cases.append({
            "Id": case_id,
            "CaseNumber": case_num,
            "Status": fields.get("Status", ""),
            "Subject": fields.get("Subject", ""),
            "fields": fields,
            "comments": [],
        })

    return cases, columns


SUPPORTSHELL_HOST = os.environ.get(
    "SUPPORTSHELL_HOST",
    "supportshell-1.sush-001.prod.us-west-2.aws.redhat.com",
)

def _get_supportshell_user() -> str:
    env = os.environ.get("SUPPORTSHELL_USER")
    if env:
        return env
    try:
        with open(CONFIG_PATH) as f:
            return json.load(f).get("supportshell_user", "")
    except Exception:
        return ""

SUPPORTSHELL_USER = _get_supportshell_user()


def _fetch_comments_hydra(case_number: str) -> list[dict]:
    """Fetch case comments via Hydra REST API on Support Shell."""
    if not SUPPORTSHELL_USER:
        # Try to detect SSH user from environment
        ssh_user = os.environ.get("USER", "")
        if not ssh_user:
            log("no SUPPORTSHELL_USER set, skipping comment fetch")
            return []
    else:
        ssh_user = SUPPORTSHELL_USER

    script = f'''
import json, urllib.request, urllib.parse
try:
    with open("/home/remote/{ssh_user}/.yank/oidc-tokens.json") as f:
        d = json.load(f)
    data = urllib.parse.urlencode({{
        "grant_type": "refresh_token",
        "refresh_token": d["refresh_token"],
        "client_id": "cee-supportshell-deviceauth"
    }}).encode()
    req = urllib.request.Request(
        "https://sso.redhat.com/auth/realms/redhat-external/protocol/openid-connect/token", data)
    tokens = json.loads(urllib.request.urlopen(req, timeout=10).read())
    at = tokens["access_token"]
    req2 = urllib.request.Request(
        "https://access.redhat.com/hydra/rest/cases/{case_number}/comments")
    req2.add_header("Authorization", "Bearer " + at)
    req2.add_header("Accept", "application/json")
    resp = urllib.request.urlopen(req2, timeout=15)
    comments = json.loads(resp.read())
    result = []
    for c in comments[-5:]:
        author = c.get("createdByUser", "")
        if isinstance(author, dict):
            author = author.get("fullName", author.get("name", ""))
        date = c.get("createdDate", "")
        body = c.get("commentBody", c.get("text", ""))
        public = c.get("isPublic", True)
        result.append({{"author": author, "date": date, "body": str(body)[:500], "isPublic": public}})
    print(json.dumps(result))
except Exception as e:
    print(json.dumps({{"error": str(e)}}))
'''
    try:
        r = subprocess.run(
            ["ssh", f"{ssh_user}@{SUPPORTSHELL_HOST}", "python3", "-c", json.dumps(script)],
            capture_output=True, text=True, timeout=30,
        )
        if r.returncode != 0:
            log(f"SSH comment fetch failed: {(r.stderr or '').strip()[:200]}")
            return []
        data = json.loads((r.stdout or "").strip())
        if isinstance(data, dict) and "error" in data:
            log(f"Hydra comment error: {data['error']}")
            return []
        return data if isinstance(data, list) else []
    except Exception as exc:
        log(f"comment fetch exception: {exc}")
        return []


def _format_comments(comments: list[dict]) -> str:
    """Format comments for email body."""
    if not comments:
        return ""
    lines = ["\n--- Recent Comments ---"]
    for c in comments:
        author = c.get("author", "").strip() or "Unknown"
        date = (c.get("date") or "")[:19].replace("T", " ")
        visibility = "Public" if c.get("isPublic", True) else "Private"
        body = (c.get("body") or "").strip()
        if body:
            lines.append(f"\n[{visibility}] {author} ({date}):")
            lines.append(body[:400])
    return "\n".join(lines)


def poll_once() -> int:
    try:
        cases, columns = scrape_cases()
    except Exception as exc:
        log(f"scrape failed: {exc}")
        return 0

    state = load_state()
    prev = state.get("cases") or {}
    initialized = bool(state.get("initialized"))
    now_map = {}
    sent = 0

    for rec in cases:
        cid = rec.get("Id") or rec.get("CaseNumber") or ""
        if not cid:
            continue
        status = rec.get("Status") or ""
        fields = rec.get("fields") or {}
        comments = rec.get("comments") or []
        latest_comment = comments[0].get("date", "") if comments else ""

        now_map[cid] = {
            "status": status,
            "number": rec.get("CaseNumber"),
            "subject": rec.get("Subject") or "",
            "fields": fields,
            "latestComment": latest_comment,
            "comments": comments[:3],
        }

        old_entry = prev.get(cid) or {}
        old_status = old_entry.get("status")
        old_comment_date = old_entry.get("latestComment", "")
        num = rec.get("CaseNumber") or cid
        subj = rec.get("Subject") or ""
        link = f"https://redhatsupport.lightning.force.com/lightning/r/Case/{cid}/view"
        comment_text = _format_comments(comments)

        if not initialized:
            continue

        # Check for status change
        if old_status is not None and old_status.strip().lower() != status.strip().lower():
            # Fetch recent comments via Hydra API on Support Shell
            fetched_comments = []
            if num:
                try:
                    log(f"fetching comments for {num} via Hydra...")
                    fetched_comments = _fetch_comments_hydra(num)
                    log(f"got {len(fetched_comments)} comments for {num}")
                except Exception as exc:
                    log(f"comment fetch failed for {num}: {exc}")
            comment_text = _format_comments(fetched_comments)

            title = f"Case {num}: {old_status} → {status}"
            body = (
                f"Salesforce case {num} status changed.\n"
                f"From: {old_status}\n"
                f"To: {status}\n"
                f"Subject: {subj}\n"
                f"{link}\n"
                f"{comment_text}\n"
            )
            notify_banner("Salesforce", title)
            try:
                send_mail(title, body)
                log(f"emailed {num} (status change)")
            except Exception as exc:
                log(f"mail failed {num}: {exc}")
            sent += 1

    state["cases"] = now_map
    state["columns"] = columns
    state["initialized"] = True
    state["lastRun"] = datetime.now(timezone.utc).isoformat()
    save_state(state)
    log(f"ok cases={len(now_map)} mailed={sent} init_was={initialized}")
    return 0


def main() -> int:
    log(f"starting — interval={INTERVAL}s url={CASE_LIST_URL}")

    if "--once" in sys.argv:
        return poll_once()

    while True:
        try:
            poll_once()
        except Exception as exc:
            log(f"poll error: {exc}")
        time.sleep(INTERVAL)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        log("stopped")
    except Exception as exc:
        log(f"fatal: {exc}")
        sys.exit(1)
