#!/usr/bin/env python3
"""Salesforce Case Notification Center v2 — Reliable event-driven poller.

Architecture:
  Chrome scraping → Event detection → SQLite queue → Notification dispatch

Features:
  - SQLite state + event store (replaces JSON)
  - Event hashing / deduplication
  - Notification retry with exponential backoff
  - Circuit breaker for SSH/Hydra
  - Startup reconciliation (no false alerts after restart)
  - Heartbeat / watchdog
  - Structured logging
  - CLI subcommands: --once, --status, --health, --test, --test-email, --poll

State:  ~/.local/state/sf-notification-center.db
Compat: ~/.local/state/sf-case-status.json  (still written for dashboard)
Log:    ~/Library/Logs/sf-case-poller.log
"""
from __future__ import annotations

