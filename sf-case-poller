# ─── Structured Logging ────────────────────────────────────────────────────
def log(level: str, msg: str, **kv) -> None:
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    extra = " ".join(f"{k}={v}" for k, v in kv.items()) if kv else ""
    line = f"{ts} {level:<5} {msg}" + (f" {extra}" if extra else "")
    os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
    with open(LOG_PATH, "a", encoding="utf-8") as fh:
        fh.write(line + "\n")

def log_info(msg, **kv):  log("INFO", msg, **kv)
def log_warn(msg, **kv):  log("WARN", msg, **kv)
def log_error(msg, **kv): log("ERROR", msg, **kv)

# ─── SQLite Database ───────────────────────────────────────────────────────
def _init_db() -> sqlite3.Connection:
    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.executescript("""
        CREATE TABLE IF NOT EXISTS cases (
            case_id         TEXT PRIMARY KEY,
            case_number     TEXT,
            status          TEXT,
            subject         TEXT,
            owner_alias     TEXT,
            fields_json     TEXT,
            last_modified   TEXT,
            last_comment_id TEXT,
            last_comment_date TEXT,
            comment_count   INTEGER DEFAULT 0,
            first_seen      TEXT,
            last_seen       TEXT
        );

        CREATE TABLE IF NOT EXISTS events (
            event_id    INTEGER PRIMARY KEY AUTOINCREMENT,
            case_id     TEXT,
            case_number TEXT,
            event_type  TEXT,
            old_value   TEXT,
            new_value   TEXT,
            event_time  TEXT,
            event_hash  TEXT UNIQUE,
            details     TEXT,
            processed   INTEGER DEFAULT 0
        );

        CREATE TABLE IF NOT EXISTS notifications (
            notif_id    INTEGER PRIMARY KEY AUTOINCREMENT,
            event_id    INTEGER REFERENCES events(event_id),
            channel     TEXT,
            subject     TEXT,
            body        TEXT,
            status      TEXT DEFAULT 'PENDING',
            retry_count INTEGER DEFAULT 0,
            created_at  TEXT,
            sent_at     TEXT,
            last_error  TEXT
        );

        CREATE TABLE IF NOT EXISTS poll_runs (
            run_id      INTEGER PRIMARY KEY AUTOINCREMENT,
            started_at  TEXT,
            finished_at TEXT,
            status      TEXT,
            cases_found INTEGER DEFAULT 0,
            events_found INTEGER DEFAULT 0,
            notifs_sent INTEGER DEFAULT 0,
            error       TEXT
        );

        CREATE TABLE IF NOT EXISTS meta (
            key   TEXT PRIMARY KEY,
            value TEXT
        );
    """)
    conn.execute("INSERT OR IGNORE INTO meta (key, value) VALUES ('initialized', '0')")
    conn.commit()
    return conn


def _db_get(conn, key: str) -> str:
    row = conn.execute("SELECT value FROM meta WHERE key=?", (key,)).fetchone()
    return row["value"] if row else ""


def _db_set(conn, key: str, value: str):
    conn.execute("INSERT OR REPLACE INTO meta (key, value) VALUES (?, ?)", (key, value))
    conn.commit()


# ─── Circuit Breaker ───────────────────────────────────────────────────────
class CircuitBreaker:
    def __init__(self):
        self.failures = 0
        self.opened_at = 0.0

    def record_failure(self):
        self.failures += 1
        if self.failures >= CB_THRESHOLD:
            self.opened_at = time.time()
            log_warn("circuit_breaker_open", failures=self.failures)

    def record_success(self):
        if self.failures > 0:
            log_info("circuit_breaker_reset")
        self.failures = 0
        self.opened_at = 0.0

    @property
    def is_open(self) -> bool:
        if self.failures < CB_THRESHOLD:
            return False
        if time.time() - self.opened_at > CB_RESET_SECONDS:
            log_info("circuit_breaker_half_open", testing="yes")
            return False
        return True

ssh_circuit = CircuitBreaker()

# ─── Event Hashing ─────────────────────────────────────────────────────────
def _event_hash(case_id: str, event_type: str, old_val: str, new_val: str) -> str:
    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    raw = f"{case_id}|{event_type}|{old_val}|{new_val}|{today}"
    return hashlib.sha256(raw.encode()).hexdigest()[:16]


# ─── Notifications ─────────────────────────────────────────────────────────
def _as_safe(s: str) -> str:
    """Sanitize text for AppleScript (ASCII only)."""
    s = s.replace("\\", "/").replace('"', "'").replace("\u2192", "->")
    return "".join(c if ord(c) < 128 else "?" for c in s)


def _send_smtp(subject: str, body: str) -> bool:
    try:
        msg = MIMEText(body)
        msg["Subject"] = subject
        msg["From"] = "sf-notify@localhost"
        msg["To"] = TO_ADDR
        with smtplib.SMTP("127.0.0.1", 2525, timeout=5) as s:
            s.send_message(msg)
        return True
    except Exception as exc:
        log_warn("smtp_failed", error=str(exc)[:120])
        return False


def _send_mailapp(subject: str, body: str) -> bool:
    if not TO_ADDR:
        return True
    content = body if body.endswith("\n") else body + "\n"
    safe_subj = _as_safe(subject)
    safe_body = _as_safe(content)
    ascript = (
        'tell application "Mail"\n'
        f'  set m to make new outgoing message with properties '
        f'{{subject:"{safe_subj}", content:"{safe_body}", visible:false}}\n'
        f'  tell m\n'
        f'    make new to recipient at end of to recipients with properties '
        f'{{address:"{TO_ADDR}"}}\n'
        f'  end tell\n'
        f'  send m\n'
        f'end tell\n'
    )
    fd, path = tempfile.mkstemp(suffix=".applescript")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(ascript)
        r = subprocess.run(["osascript", path], capture_output=True, text=True, timeout=15)
    finally:
        os.unlink(path)
    if r.returncode != 0:
        log_warn("mailapp_failed", error=(r.stderr or "").strip()[:120])
        return False
    return True


def _send_banner(title: str, body: str):
    subprocess.run(
        ["osascript", "-e",
         f'display notification {json.dumps(body[:100])} with title {json.dumps(title[:60])}'],
        check=False, capture_output=True,
    )


def dispatch_notification(conn: sqlite3.Connection, notif_id: int) -> bool:
    """Attempt to send a queued notification. Returns True on success."""
    row = conn.execute("SELECT * FROM notifications WHERE notif_id=?", (notif_id,)).fetchone()
    if not row:
        return False
    subject, body, channel = row["subject"], row["body"], row["channel"]
    now = datetime.now(timezone.utc).isoformat()

    ok = False
    if channel == "smtp":
        ok = _send_smtp(subject, body)
    elif channel == "mailapp":
        ok = _send_mailapp(subject, body)
    elif channel == "banner":
        _send_banner(subject, body)
        ok = True

    if ok:
        conn.execute("UPDATE notifications SET status='SENT', sent_at=? WHERE notif_id=?", (now, notif_id))
    else:
        retries = row["retry_count"] + 1
        status = "FAILED" if retries > len(RETRY_DELAYS) else "RETRY"
        conn.execute(
            "UPDATE notifications SET status=?, retry_count=?, last_error=? WHERE notif_id=?",
            (status, retries, f"attempt {retries} failed", notif_id),
        )
    conn.commit()
    return ok


def queue_notification(conn: sqlite3.Connection, event_id: int, subject: str, body: str):
    """Queue notifications across all channels."""
    now = datetime.now(timezone.utc).isoformat()
    for channel in ("smtp", "mailapp", "banner"):
        conn.execute(
            "INSERT INTO notifications (event_id, channel, subject, body, created_at) VALUES (?,?,?,?,?)",
            (event_id, channel, subject, body, now),
        )
    conn.commit()


def process_retry_queue(conn: sqlite3.Connection) -> int:
    """Retry failed notifications that are due."""
    rows = conn.execute(
        "SELECT notif_id, retry_count, created_at FROM notifications WHERE status='RETRY'"
    ).fetchall()
    retried = 0
    for row in rows:
        idx = min(row["retry_count"], len(RETRY_DELAYS) - 1)
        delay = RETRY_DELAYS[idx]
        created = datetime.fromisoformat(row["created_at"])
        age = (datetime.now(timezone.utc) - created.replace(tzinfo=timezone.utc)).total_seconds()
        if age >= delay * (row["retry_count"]):
            if dispatch_notification(conn, row["notif_id"]):
                retried += 1
    return retried


# ─── Heartbeat ─────────────────────────────────────────────────────────────
def _write_heartbeat(cases: int, status: str, error: str = ""):
    data = {
        "last_successful_poll": datetime.now(timezone.utc).isoformat(),
        "cases": cases,
        "status": status,
