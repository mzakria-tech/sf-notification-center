def _get_label():
    return f"com.{os.environ.get('USER', 'mzakria')}.sf-case-poller"

def _get_plist_path():
    return os.path.expanduser(f"~/Library/LaunchAgents/{_get_label()}.plist")

def cmd_install():
    """Install poller, config, and LaunchAgent — everything needed to run."""
    home = os.path.expanduser("~")
    user = os.environ.get("USER", "mzakria")
    script_src = os.path.abspath(__file__)
    script_dst = os.path.join(home, ".local", "bin", "sf-case-poller")

    # 1. Install script
    os.makedirs(os.path.dirname(script_dst), exist_ok=True)
    if os.path.abspath(script_src) != os.path.abspath(script_dst):
        import shutil
        shutil.copy2(script_src, script_dst)
        os.chmod(script_dst, 0o755)
    print(f"[1/4] Installed: {script_dst}")

    # 2. Add to PATH
    zshrc = os.path.join(home, ".zshrc")
    path_line = 'export PATH="$HOME/.local/bin:$PATH"'
    if os.path.exists(zshrc):
        with open(zshrc) as f:
            content = f.read()
        if ".local/bin" not in content:
            with open(zshrc, "a") as f:
                f.write(f"\n{path_line}\n")
            print("[2/4] Added ~/.local/bin to PATH in .zshrc")
        else:
            print("[2/4] PATH already configured")
    else:
        print("[2/4] No .zshrc found, add manually: " + path_line)

    # 3. Create config
    cfg_path = os.path.join(home, ".local", "state", "sf-poller-config.json")
    os.makedirs(os.path.dirname(cfg_path), exist_ok=True)
    if not os.path.exists(cfg_path):
        cfg = {
            "case_list_url": "https://redhatsupport.lightning.force.com/lightning/o/Case/list?filterName=My_ca",
            "notify_email": f"{user}@redhat.com",
            "supportshell_user": user,
        }
        with open(cfg_path, "w") as f:
            json.dump(cfg, f, indent=2)
        print(f"[3/4] Config created: {cfg_path}")
    else:
        print(f"[3/4] Config exists: {cfg_path}")

    # 4. Install LaunchAgent
    plist_path = _get_plist_path()
    label = _get_label()
    plist = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{label}</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>{script_dst}</string>
        <string>poll</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>SF_POLL_INTERVAL</key>
        <string>60</string>
    </dict>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>{home}/Library/Logs/sf-case-poller.log</string>
    <key>StandardErrorPath</key>
    <string>{home}/Library/Logs/sf-case-poller.log</string>
</dict>
</plist>"""
    os.makedirs(os.path.dirname(plist_path), exist_ok=True)
    subprocess.run(["launchctl", "unload", plist_path], capture_output=True)
    with open(plist_path, "w") as f:
        f.write(plist)
    subprocess.run(["launchctl", "load", plist_path], capture_output=True)
    subprocess.run(["launchctl", "start", label], capture_output=True)
    print(f"[4/4] LaunchAgent installed and started")

    # 5. Test SSH and check GraphQL token on supportshell
    print("[5/6] Setting up supportshell SSH + GraphQL token...")
    ssh_host = f"{user}@supportshell-1.sush-001.prod.us-west-2.aws.redhat.com"
    try:
        ssh_test = subprocess.run(
            ["ssh", "-o", "ConnectTimeout=10", "-o", "BatchMode=yes", ssh_host, "echo SSH_OK"],
            capture_output=True, text=True, timeout=15,
        )
        if "SSH_OK" in (ssh_test.stdout or ""):
            print(f"  SSH to supportshell: OK")
            # Check if GraphQL token already exists
            token_check = subprocess.run(
                ["ssh", "-o", "ConnectTimeout=10", ssh_host,
                 "test -f ~/.cache/hydra-mcp/tokens/redhat-sso-token.json && echo GQL_TOKEN_OK; "
                 "test -f ~/.yank/oidc-tokens.json && echo YANK_TOKEN_OK"],
                capture_output=True, text=True, timeout=15,
            )
            has_gql = "GQL_TOKEN_OK" in (token_check.stdout or "")
            has_yank = "YANK_TOKEN_OK" in (token_check.stdout or "")
            if has_gql:
                print(f"  GraphQL token: OK")
            elif has_yank:
                print(f"  Yank token found (will use as fallback)")
                print(f"  For best results, run on supportshell: redhat-hydra-auth --production")
            else:
                print(f"  GraphQL token: NOT FOUND")
                print(f"  Run once on supportshell:")
                print(f"    ssh {ssh_host}")
                print(f"    redhat-hydra-auth --production")
        else:
            print(f"  SSH to supportshell: FAILED")
            print(f"    Fix: ssh-copy-id {ssh_host}")
    except Exception as e:
        print(f"  SSH check failed: {str(e)[:80]}")
        print(f"  Ensure SSH works: ssh {ssh_host}")

    # 6. Open dashboard in browser
    print("[6/6] Opening dashboard...")
    try:
        subprocess.Popen(["open", "http://localhost:8090"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("  Dashboard: http://localhost:8090")
    except Exception:
        print("  Dashboard: http://localhost:8090 (open manually)")

    print(f"\n{'='*50}")
    print("INSTALLED SUCCESSFULLY!")
    print(f"{'='*50}")
    print(f"\nOpen Chrome with your Salesforce case list view, then you're all set!")
    print(f"\nCommands:")
    print(f"  sf-case-poller status      # Check status")
    print(f"  sf-case-poller health      # Health check")
    print(f"  sf-case-poller start       # Start poller")
    print(f"  sf-case-poller stop        # Stop poller")
    print(f"  sf-case-poller restart     # Restart poller")
    print(f"  sf-case-poller logs        # View live logs")
    print(f"  sf-case-poller test-email  # Test email")
    print(f"  sf-case-poller history     # Notification history")
    print(f"  sf-case-poller uninstall   # Remove everything")

def cmd_uninstall():
